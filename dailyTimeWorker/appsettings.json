{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "DisableHttpsRedirection": true,
  "DailyTimeApi": {
    "BaseUrl": "https://localhost:5110",
    "IgnoreSslErrors": true
  },
  "Worker": {
    "PollIntervalSeconds": 20,
    "EnableAutoScrape": false,
    "UsePlaywright": true,
    "Headless": false,
    "BrowserChannel": "chrome",
    "BrowserExecutablePath": "",
    "SlowMoMs": 400,
    "DelayBetweenUrlsMs": 5000,
    "ChallengeWaitSeconds": 300,
    "UseRemoteDebuggingBrowser": true,
    "RemoteDebuggingUrl": "http://127.0.0.1:9222",
    "UsePersistentProfile": false,
    "BrowserProfileDir": "",
    "BrowserProfileName": "Default",
    "CloneBrowserProfile": false,
    "BrowserProfileCloneDir": ""
  },
  "Notifications": {
    "Smtp": {
      "Enabled": false,
      "Host": "",
      "Port": 587,
      "UseSsl": true,
      "User": "",
      "Password": "",
      "From": "noreply@dailytime.local"
    }
  },
  "Cors": {
    "Origins": "http://localhost:4010"
  }
}
