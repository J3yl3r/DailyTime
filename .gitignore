# DailyTime — monorepo (reglas comunes)
# Cada proyecto puede tener reglas extra en su propio .gitignore

# Secrets / env
.env
.env.*
!.env.example
!**/.env.example
*.pem
*.pfx
secrets.json
appsettings.*.local.json
**/appsettings.Local.json
**/appsettings.Development.local.json

# Cursor / agentes locales
.cursor/

# Perfiles de navegador del worker (datos de sesión)
**/playwright-profile*/
**/chrome-profile-clone*/
**/ms-playwright/

# OS
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db
$RECYCLE.BIN/

# IDEs
.vs/
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates
*.rsuser

# Logs y runtime local
logs/
*.log
*.tmp

# Builds .NET (por si se generan fuera de cada carpeta)
**/[Bb]in/
**/[Oo]bj/
**/[Oo]ut/
artifacts/

# Node (por si hay tooling en raíz)
node_modules/

# Playwright / browsers cache
**/.playwright/
**/playwright-report/
**/test-results/

# Docker overrides locales
docker-compose.override.yml

# CVs / PII personal (no subir al repo)
documentos/
